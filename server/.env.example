PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexoffer
JWT_SECRET=nexoffer_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# LLM Gateway Configuration
# Primary: Google Gemini API (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback: Grok (xAI) API
GROK_API_KEY=
GROK_MODEL=grok-beta

# Optional: Other LLM (e.g., OpenRouter / Groq / OpenAI-compatible endpoint)
OTHER_LLM_API_KEY=
OTHER_LLM_ENDPOINT=
OTHER_LLM_MODEL=

# Email OTP Service (Leave blank to use development console/toast logging)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=NexOffer <noreply@nexoffer.com>
